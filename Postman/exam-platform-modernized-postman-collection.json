    {
      "name": "5. AI Chatbot Service (Spring AI)",
      "item": [
        {
          "name": "Stream Chat Response (SSE)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "text/event-stream" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversationId\": \"chat-session-882\",\n  \"message\": \"Explain the difference between Saga Choreography and Orchestration for the upcoming exam.\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/v1/ai/chat/stream",
              "host": ["{{gateway_url}}"],
              "path": ["api", "v1", "ai", "chat", "stream"]
            }
          },
          "response": [
            {
              "name": "200 OK (SSE Stream Event Chunks)",
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "text/event-stream" },
                { "key": "Cache-Control", "value": "no-cache" }
              ],
              "body": "data:In Saga Choreography,\n\ndata: services react to domain events\n\ndata: without a centralized coordinator.\n\ndata: Orchestration uses a central coordinator.\n\n"
            }
          ]
        }
      ]
